{
  "name": "codefive-app",
  "version": "0.1.0",
  "description": "CodeFive: entrenamiento adaptativo para técnicos de autobuses (Reto Volvo, HackaTec 2026)",
  "private": true,
  "type": "module",
  "imports": {
    "#app": "./server/app.js",
    "#config/*": "./server/config/*",
    "#db/*": "./server/db/*",
    "#routes/*": "./server/routes/*",
    "#controllers/*": "./server/controllers/*",
    "#services/*": "./server/services/*",
    "#helpers/*": "./server/helpers/*"
  },
  "scripts": {
    "dev": "nodemon server/bin/www.js",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/bin/www.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "express-handlebars": "^7.1.3",
    "morgan": "^1.12.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.7.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  }
}
