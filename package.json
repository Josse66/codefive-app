{
  "name": "codefive-app",
  "version": "0.1.0",
  "description": "CodeFive: entrenamiento adaptativo para técnicos de autobuses (Reto Volvo, HackaTec 2026)",
  "private": true,
  "type": "module",
  "imports": {
    "#app": "./server/app.js",
    "#config/*": "./server/config/*",
    "#db/*": "./server/db/*",
    "#routes/*": "./server/routes/*",
    "#controllers/*": "./server/controllers/*",
    "#services/*": "./server/services/*",
    "#helpers/*": "./server/helpers/*"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node --disable-warning=ExperimentalWarning server/bin/www.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:reset": "node --disable-warning=ExperimentalWarning server/db/reset.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/**/*.test.js\"",
    "db:demo": "cross-env LOG_LEVEL=warn node --disable-warning=ExperimentalWarning server/db/demo.js",
    "demo": "vite build && cross-env NODE_ENV=production node --disable-warning=ExperimentalWarning server/bin/www.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "chart.js": "^4.6.2",
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "express-handlebars": "^7.1.3",
    "jsqr": "^1.4.0",
    "morgan": "^1.12.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.187.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.7.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  }
}
