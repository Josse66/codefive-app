<section id="diagnostico" class="mx-auto grid max-w-3xl gap-6" data-tecnico-id="{{tecnico.id}}">
  <div class="grid gap-2">
    <h1 class="text-4xl leading-tight lg:text-5xl">Diagnóstico de {{tecnico.nombre}}</h1>
    <p class="text-tinta-2">Preguntas que suben o bajan de nivel según lo que contestes. No te decimos si acertaste: solo ubicamos tu nivel en cada grupo de función.</p>
  </div>

  <div class="grid gap-2">
    <div class="flex flex-wrap justify-between gap-2 text-sm">
      <span id="progreso-texto" class="font-semibold">Preparando…</span>
      <span class="text-tinta-3">Responde con lo que harías en el taller</span>
    </div>
    <div class="h-1.5 bg-placa-2">
      <div id="progreso-barra" class="h-1.5 bg-tinta transition-[width] duration-500 ease-out" style="width: 0%"></div>
    </div>
  </div>

  <div id="tarjeta-pregunta" class="grid gap-6 border border-placa-linea bg-white p-6 lg:p-8" hidden>
    <div class="flex items-center gap-3">
      <span id="pregunta-grupo" class="recuadro"></span>
      <p id="pregunta-area" class="text-sm font-semibold text-tinta-2"></p>
    </div>
    <h2 id="pregunta-enunciado" class="font-sans text-2xl font-semibold leading-snug tracking-normal"></h2>
    <div id="pregunta-opciones" class="grid gap-2" role="radiogroup" aria-labelledby="pregunta-enunciado"></div>

    <hr class="border-placa-linea">
    <fieldset id="confianza" class="grid gap-2" disabled>
      <legend class="mb-2 font-semibold">¿Qué tan seguro estás de tu respuesta?</legend>
      <div class="grid gap-2 sm:grid-cols-3">
        <button type="button" class="opcion-confianza" data-valor="1">No estoy seguro</button>
        <button type="button" class="opcion-confianza" data-valor="2">Creo que sí</button>
        <button type="button" class="opcion-confianza" data-valor="3">Estoy seguro</button>
      </div>
    </fieldset>

    <div class="flex justify-end">
      <button id="boton-siguiente" type="button" class="boton min-w-48" disabled>Siguiente</button>
    </div>
  </div>

  <p id="mensaje-error" class="aviso-critico" hidden></p>
</section>
