<section class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_440px] lg:items-start">
  <div class="grid gap-5">
    <div class="grid gap-2">
      <h1 class="text-4xl leading-tight lg:text-5xl">Competencias de {{tecnico.nombre}}</h1>
      <p class="max-w-[65ch] text-tinta-2">Cada recuadro es un grupo de función del autobús. El color dice cómo va el técnico en ese grupo; selecciona uno para ver sus competencias.</p>
    </div>

    {{#unless evaluado}}
      <p class="border border-placa-linea bg-white p-4 text-[15px]">Todavía no hace el diagnóstico. Los colores son el punto de partida estimado por su experiencia, no un resultado.
        <a href="/tecnicos/{{tecnico.id}}/diagnostico" class="font-semibold underline">Hacer diagnóstico</a></p>
    {{/unless}}

    <figure class="grid border border-tinta bg-white">
      <div class="p-4 lg:p-6">
        {{> lamina-autobus grupos=grupos}}
      </div>
      <div class="flex flex-wrap gap-2 border-t border-placa-linea p-4 lg:hidden" role="group" aria-label="Grupos de función">
        {{#each grupos}}
          {{#if competencias.length}}
            <button type="button" class="boton-grupo recuadro h-11 w-11 text-lg aria-pressed:outline aria-pressed:outline-[3px] aria-pressed:outline-offset-2 aria-pressed:outline-tinta" style="background: {{rellenoEstado estado}}" data-grupo="{{numero}}" aria-pressed="{{#if seleccionado}}true{{else}}false{{/if}}" aria-label="Grupo {{numero}}, {{nombre}}: {{nombreEstado estado}}">{{numero}}</button>
          {{else}}
            <span class="recuadro h-11 w-11 text-lg" style="background: {{rellenoEstado estado}}" aria-label="Grupo {{numero}}, {{nombre}}: sin competencias en el prototipo">{{numero}}</span>
          {{/if}}
        {{/each}}
      </div>
      <figcaption class="grid border-t border-tinta text-sm sm:grid-cols-[minmax(0,1fr)_auto]">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 p-3 text-tinta-2">
          <span class="flex items-center gap-2"><span class="h-3.5 w-3.5 bg-ok"></span>Dominado · {{resumen.dominadas}}</span>
          <span class="flex items-center gap-2"><span class="h-3.5 w-3.5 bg-med"></span>En desarrollo · {{resumen.enDesarrollo}}</span>
          <span class="flex items-center gap-2"><span class="h-3.5 w-3.5 bg-mal"></span>Brecha · {{resumen.brechas}}</span>
          <span class="flex items-center gap-2"><span class="h-3.5 w-3.5 bg-nada"></span>Sin competencias aún</span>
          <span class="flex items-center gap-2"><span class="h-3.5 w-3.5 border border-hv bg-hv-suave"></span>Alto voltaje 600 V</span>
        </div>
        <div class="grid grid-cols-2 border-t border-tinta sm:border-l sm:border-t-0">
          <span class="border-r border-placa-linea px-3 py-2"><span class="block text-xs text-tinta-3">Figura</span><span class="codigo">Grupos de función</span></span>
          <span class="px-3 py-2"><span class="block text-xs text-tinta-3">Lámina</span><span class="codigo">{{tecnico.id}} · Rev. demo</span></span>
        </div>
      </figcaption>
    </figure>

    <p class="max-w-[65ch] text-sm text-tinta-3">Dominio = probabilidad estimada de que domine la competencia. "Deducida": no se preguntó directo; se infirió de otras respuestas del grupo. Umbrales del prototipo: dominada desde 80 %, en desarrollo desde 40 %.</p>
  </div>

  <div class="grid gap-4 lg:sticky lg:top-6">
    {{#each grupos}}
      <article id="grupo-{{numero}}" class="panel-grupo grid gap-4 border border-placa-linea bg-white p-5" {{#unless seleccionado}}hidden{{/unless}} aria-live="polite">
        <div class="flex items-start gap-3">
          <span class="recuadro h-9 w-9 text-lg">{{numero}}</span>
          <div class="grid gap-1">
            <h2 class="text-2xl leading-tight">{{nombre}}</h2>
            <span class="chip w-fit {{claseEstado estado}}">{{nombreEstado estado}}</span>
          </div>
        </div>

        {{#if alertas.length}}
          <div class="aviso-critico grid gap-1">
            <p class="font-semibold text-mal">Respondió seguro y se equivocó</p>
            <p>Refuerzo obligatorio antes de avanzar en
              {{#each alertas}}<span class="codigo">{{id}}</span>{{#unless @last}} y {{/unless}}{{/each}}.</p>
          </div>
        {{/if}}

        {{#if competencias.length}}
          <div class="flex flex-wrap gap-2">
            {{#if siguiente}}
              <a href="/tecnicos/{{../tecnico.id}}/practica/{{siguiente.id}}" class="boton">Practicar {{siguiente.id}}</a>
            {{/if}}
            <a href="/tecnicos/{{../tecnico.id}}/ruta" class="boton-linea">Ver ruta completa</a>
          </div>
          <table class="tabla-partes">
            <thead><tr><th>Código</th><th>Competencia</th><th class="text-right">Dominio</th></tr></thead>
            <tbody>
              {{#each competencias}}
                <tr>
                  <td class="codigo whitespace-nowrap">{{id}}</td>
                  <td>
                    {{nombre}}
                    <span class="mt-1 flex flex-wrap items-center gap-x-1 text-xs text-tinta-3">Nivel {{nivel}} · {{nombreHabilidad habilidad}}{{#if critica}} · <span class="font-semibold text-mal">seguridad crítica</span>{{/if}}{{#unless evaluada}} · deducida{{/unless}}</span>
                    {{#if (altoVoltaje tecnologia grupo)}}<span class="marca-hv mt-1.5">Alto voltaje 600 V</span>{{/if}}
                  </td>
                  <td class="text-right"><span class="chip {{claseEstado estado}}">{{porcentaje pSaber}} %</span></td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        {{else}}
          <p class="text-[15px] text-tinta-2">Este grupo todavía no tiene competencias en el prototipo. Se agregan como datos, sin cambiar la app.</p>
        {{/if}}
      </article>
    {{/each}}
  </div>
</section>
