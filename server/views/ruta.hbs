<section class="grid gap-8">
  <div class="grid gap-2">
    <h1 class="text-4xl leading-tight lg:text-5xl">Ruta de {{tecnico.nombre}}</h1>
    <p class="max-w-2xl text-tinta-2">Solo lo que le falta, en el orden en que conviene practicarlo: seguridad crítica primero, luego requisitos y después la brecha más grande.</p>
  </div>

  {{#if siguiente}}
    <article class="grid gap-6 border border-tinta bg-white p-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:p-8">
      <div class="grid gap-3">
        <h2 class="flex flex-wrap items-baseline gap-x-4 gap-y-1 font-sans text-2xl font-semibold tracking-normal">
          <span class="codigo text-4xl lg:text-5xl">Sigue {{siguiente.competencia.id}}</span>
          <span>{{siguiente.competencia.nombre}}</span>
        </h2>
        <p class="text-tinta-2">{{nombreGrupo siguiente.competencia.grupo}} · {{nombreTecnologia siguiente.competencia.tecnologia}} · Nivel {{siguiente.competencia.nivel}}</p>
        <div class="flex flex-wrap gap-2">
          <span class="chip {{claseEstado siguiente.competencia.estado}}">{{porcentaje siguiente.competencia.pSaber}} % · {{nombreEstado siguiente.competencia.estado}}</span>
          <span class="chip border-tinta-3 text-tinta-2">Modo {{nombreModo siguiente.modo}}</span>
          {{#if siguiente.obligatoria}}<span class="chip border-mal bg-mal text-white">Obligatoria</span>{{/if}}
          {{#if (altoVoltaje siguiente.competencia.tecnologia siguiente.competencia.grupo)}}<span class="marca-hv">Alto voltaje 600 V</span>{{/if}}
        </div>
        <p class="text-[15px]">{{siguiente.motivo}}{{#if siguiente.bloqueadaPor}} · primero: {{siguiente.bloqueadaPor.nombre}}{{/if}}</p>
      </div>
      <div class="grid gap-2 lg:min-w-56">
        <a href="/tecnicos/{{tecnico.id}}/practica/{{siguiente.competencia.id}}" class="boton px-8 py-4 text-base">Practicar ahora</a>
        {{#if siguiente.escenario}}<p class="text-center text-sm text-tinta-3">Con escenario 3D: {{siguiente.escenario}}</p>{{/if}}
      </div>
    </article>

    {{#if despues.length}}
      <div class="grid gap-3">
        <h2 class="text-2xl">Después</h2>
        <div class="overflow-x-auto border border-placa-linea bg-white">
          <table class="tabla-partes min-w-[900px]">
            <thead>
              <tr><th>#</th><th>Código</th><th>Competencia</th><th>Dominio</th><th>Modo</th><th>Por qué</th><th><span class="sr-only">Acción</span></th></tr>
            </thead>
            <tbody>
              {{#each despues}}
                <tr>
                  <td class="codigo text-tinta-3">{{orden}}</td>
                  <td class="codigo whitespace-nowrap">{{competencia.id}}</td>
                  <td>
                    {{competencia.nombre}}
                    <span class="mt-1 block text-xs text-tinta-3">{{nombreGrupo competencia.grupo}} · Nivel {{competencia.nivel}}{{#if escenario}} · escenario 3D{{/if}}</span>
                    {{#if (altoVoltaje competencia.tecnologia competencia.grupo)}}<span class="marca-hv mt-1.5">Alto voltaje 600 V</span>{{/if}}
                  </td>
                  <td><span class="chip {{claseEstado competencia.estado}}">{{porcentaje competencia.pSaber}} %</span></td>
                  <td class="whitespace-nowrap">{{nombreModo modo}}</td>
                  <td class="text-sm">
                    {{#if obligatoria}}<span class="font-semibold text-mal">Obligatoria.</span> {{/if}}{{motivo}}{{#if bloqueadaPor}} · primero {{bloqueadaPor.id}}{{/if}}
                  </td>
                  <td class="text-right"><a href="/tecnicos/{{../tecnico.id}}/practica/{{competencia.id}}" class="font-semibold underline">Practicar</a></td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    {{/if}}
  {{else}}
    <div class="grid gap-3 border border-ok bg-ok-suave p-6">
      <h2 class="text-2xl text-ok">Domina todas las competencias evaluadas</h2>
      <p>Lo siguiente son repasos para comprobar que las conserva con el tiempo.</p>
      <a href="/tecnicos/{{tecnico.id}}/perfil" class="boton w-fit">Ver competencias</a>
    </div>
  {{/if}}
</section>
