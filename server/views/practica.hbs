<section id="practica" class="grid gap-6" data-tecnico-id="{{tecnico.id}}" data-competencia-id="{{competenciaId}}">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="grid gap-2">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <span class="codigo text-3xl lg:text-4xl">{{competenciaId}}</span>
        <h1 id="titulo-competencia" class="font-sans text-3xl font-semibold leading-tight tracking-normal">Cargando…</h1>
      </div>
      <p id="detalle-competencia" class="text-tinta-2"></p>
    </div>
    <a href="/tecnicos/{{tecnico.id}}/ruta" class="boton-linea">Volver a la ruta</a>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
    <div class="grid gap-6">
      <article id="leccion" class="grid gap-4 border border-tinta bg-white p-6 lg:p-8" hidden>
        <h2 id="leccion-titulo" class="text-3xl"></h2>
        <ol id="leccion-puntos" class="grid gap-3"></ol>
        <p id="leccion-fuente" class="border-t border-placa-linea pt-3 text-sm text-tinta-3"></p>
        <button id="boton-empezar" type="button" class="boton w-fit px-8">Ya lo leí, practicar</button>
      </article>

      <div id="tarjeta-pregunta" class="grid gap-6 border border-placa-linea bg-white p-6 lg:p-8" hidden>
        <p id="pregunta-numero" class="text-sm font-semibold text-tinta-2"></p>
        <h2 id="pregunta-enunciado" class="font-sans text-2xl font-semibold leading-snug tracking-normal"></h2>
        <div id="pregunta-opciones" class="grid gap-2" role="radiogroup" aria-labelledby="pregunta-enunciado"></div>

        <hr class="border-placa-linea">
    <fieldset id="confianza" class="grid gap-2" disabled>
          <legend class="mb-2 font-semibold">¿Qué tan seguro estás de tu respuesta?</legend>
          <div class="grid gap-2 sm:grid-cols-3">
            <button type="button" data-valor="1">No estoy seguro</button>
            <button type="button" data-valor="2">Creo que sí</button>
            <button type="button" data-valor="3">Estoy seguro</button>
          </div>
        </fieldset>

        <div id="pista" class="border border-med bg-med-suave p-4 text-[15px]" hidden></div>
        <div id="retroalimentacion" class="grid gap-1 border p-4" hidden aria-live="polite"></div>

        <div class="flex flex-wrap items-center justify-between gap-3">
          <button id="boton-pista" type="button" class="boton-linea" hidden>Ver pista</button>
          <div class="ml-auto flex gap-2">
            <button id="boton-comprobar" type="button" class="boton min-w-48" disabled>Comprobar</button>
            <button id="boton-siguiente" type="button" class="boton min-w-48" hidden>Siguiente</button>
          </div>
        </div>
      </div>

      <div id="resumen" class="grid gap-3 border border-tinta bg-white p-6 lg:p-8" hidden>
        <h2 id="resumen-titulo" class="text-3xl"></h2>
        <p id="resumen-texto"></p>
        <a href="/tecnicos/{{tecnico.id}}/ruta" class="boton w-fit">Ver la ruta actualizada</a>
      </div>

      <p id="mensaje-error" class="aviso-critico" hidden></p>
    </div>

    <aside class="grid gap-3 border border-placa-linea bg-white p-5 lg:sticky lg:top-6" aria-label="Dominio de la competencia">
      <p class="text-sm font-semibold text-tinta-2">Dominio estimado</p>
      <p class="codigo text-5xl" id="dominio-texto">—</p>
      <div class="relative h-3 bg-placa-2">
        <div id="dominio-barra" class="h-3 bg-tinta transition-[width] duration-700 ease-out" style="width: 0%"></div>
        <span class="absolute inset-y-[-4px] left-[40%] w-px bg-tinta-3" aria-hidden="true"></span>
        <span class="absolute inset-y-[-4px] left-[80%] w-px bg-tinta-3" aria-hidden="true"></span>
      </div>
      <div class="flex justify-between text-xs text-tinta-3"><span>Brecha</span><span class="pl-6">En desarrollo</span><span>Dominada</span></div>
      <p id="modo-texto" class="chip w-fit border-tinta-3 text-tinta-2"></p>
      <p class="text-sm text-tinta-3">La ayuda se retira conforme mejoras: guiado, con pistas y autónomo.</p>
    </aside>
  </div>
</section>
