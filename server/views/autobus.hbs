{{!-- El simulador: un solo autobús completo (exterior, interior, motor y sistemas) y aprender sobre él.
     Izquierda: sistemas. Derecha: la tarjeta de enseñanza. El autobús ocupa toda la pantalla. --}}
<main id="sim" class="fixed inset-0" data-tecnico-id="{{tecnico.id}}" data-experiencia="{{tecnico.experiencia}}" data-nombre="{{tecnico.nombre}}">
  <div id="lienzo" class="absolute inset-0"></div>

  {{! Barra superior: vistas del autobús y salida. }}
  <header class="absolute inset-x-0 top-0 z-20 flex h-12 items-center gap-3 bg-tinta px-4 text-white">
    <span class="flex items-center gap-2 font-narrow text-base font-bold uppercase tracking-wide">
      <span class="recuadro h-6 w-6 bg-white text-[13px] text-tinta" aria-hidden="true">T</span>
      Autobús urbano diésel
    </span>
    <nav class="ml-4 flex flex-wrap gap-1 text-sm" aria-label="Vistas del autobús">
      <button id="vista-fuera" type="button" class="vista" aria-pressed="true">Por fuera</button>
      <button id="vista-dentro" type="button" class="vista" aria-pressed="false">Caminar (primera persona)</button>
      <button id="vista-rayos" type="button" class="vista" aria-pressed="false">Rayos X</button>
      <button id="vista-tapa" type="button" class="vista" aria-pressed="false">Abrir motor</button>
      <button id="vista-sonido" type="button" class="vista" aria-pressed="true">Sonido</button>
    </nav>
    <span class="ml-auto text-sm text-placa-linea">{{tecnico.nombre}}</span>
    <form method="post" action="/salir"><button type="submit" class="text-sm text-white underline decoration-placa-linea hover:decoration-white">Salir</button></form>
  </header>

  {{! Sistemas del autobús. }}
  <aside id="panel-sistemas" class="absolute bottom-3 left-3 top-[60px] z-10 flex w-72 flex-col border border-tinta bg-white/95">
    <h2 class="border-b border-placa-linea px-4 py-3 font-narrow text-sm font-bold uppercase tracking-wider text-tinta-2">Sistemas del autobús</h2>
    <ol id="lista-sistemas" class="flex-1 overflow-y-auto"></ol>
    <p class="border-t border-placa-linea px-4 py-2 text-xs text-tinta-3">Grupos de función Volvo FG 2 a FG 9</p>
  </aside>

  {{! Tarjeta de enseñanza: cambia según el momento (elegir, conocer, encontrar, comprobar). }}
  <section id="tarjeta" class="absolute right-3 top-[60px] z-10 grid max-h-[calc(100vh-72px)] w-[400px] gap-4 overflow-y-auto border-2 border-tinta bg-white p-5" aria-live="polite"></section>

  {{! Nombre de la pieza bajo el cursor (solo explorando libremente). }}
  <p id="etiqueta-pieza" class="pointer-events-none absolute bottom-16 left-1/2 z-10 -translate-x-1/2 border border-tinta bg-white px-3 py-1.5 text-sm font-semibold" hidden></p>
  {{! Experiencia Adulto Mayor: botones grandes para mover la vista (sin teclado ni clic derecho). }}
  <div id="controles-mayor" class="absolute bottom-4 left-4 z-10 grid grid-cols-3 gap-2" hidden>
    <button id="ctrl-acercar" type="button" class="boton-grande">➕ Acercar</button>
    <button id="ctrl-girar-izq" type="button" class="boton-grande">↺ Girar</button>
    <button id="ctrl-rayos" type="button" class="boton-grande">👁 Ver por dentro</button>
    <button id="ctrl-alejar" type="button" class="boton-grande">➖ Alejar</button>
    <button id="ctrl-girar-der" type="button" class="boton-grande">↻ Girar</button>
    <button id="ctrl-motor" type="button" class="boton-grande">🔧 Abrir motor</button>
  </div>
  <p id="ayuda" class="pointer-events-none absolute bottom-3 left-1/2 z-10 -translate-x-1/2 bg-white/90 px-3 py-1.5 text-xs text-tinta-2">Clic derecho y arrastrar: girar · rueda: acercar · clic en una pieza: verla</p>
</main>
