<section id="autobus" class="grid gap-5" data-tecnico-id="{{tecnico.id}}" data-autobus="{{autobus}}">
  <div class="grid gap-2">
    <h1 class="text-4xl leading-tight lg:text-5xl">El autobús por grupos de función</h1>
    <p class="max-w-3xl text-tinta-2">Cada recuadro es un grupo de función, con el color del dominio de {{tecnico.nombre}}. Elige uno para ver su escenario de práctica.</p>
  </div>

  <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_380px] lg:items-start">
    <div class="relative h-[460px] border border-tinta bg-placa lg:h-[620px]">
      <div id="lienzo" class="absolute inset-0"></div>
      <div class="pointer-events-none absolute bottom-3 left-3 flex flex-wrap gap-x-4 gap-y-1 bg-white/90 px-3 py-2 text-xs">
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 bg-ok"></span>Dominada</span>
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 bg-med"></span>En desarrollo</span>
        <span class="flex items-center gap-1.5"><span class="h-3 w-3 bg-mal"></span>Brecha</span>
        <span class="text-tinta-3">Clic derecho: girar · rueda: acercar</span>
      </div>
    </div>

    <aside class="grid gap-4">
      <article id="ficha" class="grid gap-3 border-2 border-tinta bg-white p-5">
        <div class="flex items-baseline gap-3">
          <span id="ficha-grupo" class="recuadro h-9 w-9 text-xl"></span>
          <h2 id="ficha-nombre" class="text-2xl"></h2>
        </div>
        <p class="font-semibold" id="ficha-titulo"></p>
        <p id="ficha-sintoma" class="text-tinta-2"></p>
        <p class="flex flex-wrap items-center gap-2 text-sm"><span id="ficha-competencia" class="codigo"></span><span id="ficha-estado" class="chip"></span><span id="ficha-profundidad" class="text-tinta-3"></span></p>
        <a id="ficha-enlace" href="#" class="boton w-fit px-6">Practicar este escenario</a>
      </article>
      <ol id="lista-grupos" class="grid border border-placa-linea bg-white"></ol>
    </aside>
  </div>
  <p id="mensaje-error" class="aviso-critico" hidden></p>
</section>
