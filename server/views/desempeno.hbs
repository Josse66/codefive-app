<section class="grid gap-8">
  <div class="grid gap-3">
    <p class="font-narrow text-sm font-bold uppercase tracking-wider text-tinta-3">Mi desempeño · {{d.carrera.modelo.nombre}}</p>
    <h1 class="text-4xl leading-tight lg:text-5xl">Vas en nivel {{d.carrera.nombreNivelGlobal}}</h1>
    <div class="grid max-w-2xl gap-1">
      <div class="h-3 bg-placa-2" aria-hidden="true"><div class="h-3 bg-tinta" style="width: {{d.carrera.avanceExperto}}%"></div></div>
      <p class="text-tinta-2"><strong>{{d.carrera.avanceExperto}} %</strong> del camino a experto · te faltan unas {{d.carrera.horasRestantes}} horas de estudio y práctica.</p>
    </div>
  </div>

  <div class="grid gap-3">
    <h2 class="text-3xl">Cómo vas</h2>
    <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      {{#each d.metricas}}
        <li class="grid content-start gap-1.5 border-2 bg-white p-4 {{#if (igual tono 'ok')}}border-ok{{else if (igual tono 'mal')}}border-mal{{else if (igual tono 'med')}}border-med{{else}}border-placa-linea{{/if}}">
          <p class="text-sm font-semibold text-tinta-2">{{nombre}}</p>
          <p class="font-sans text-2xl font-semibold leading-tight {{#if (igual tono 'mal')}}text-mal{{/if}}">{{valor}}</p>
          <p class="text-sm text-tinta-2">{{texto}}</p>
        </li>
      {{/each}}
    </ul>
  </div>

  {{#if d.repasar.length}}
    <div class="grid gap-2 border-2 border-tinta bg-white p-5">
      <h2 class="font-sans text-2xl font-semibold tracking-normal">Lo que más te conviene trabajar ahora</h2>
      <ul class="grid gap-1 text-[16px]">{{#each d.repasar}}<li>· {{this}}</li>{{/each}}</ul>
      <a href="/tecnicos/{{tecnico.id}}/plan" class="boton mt-2 w-fit px-6 py-3">Ir a mi siguiente misión</a>
    </div>
  {{/if}}

  <div class="grid gap-3">
    <h2 class="text-3xl">Mi nivel en cada grupo</h2>
    <p class="text-tinta-2">El nivel es por grupo, como en Volvo: puedes ir avanzado en frenos y básico en el sistema eléctrico.</p>
    {{> matriz-carrera carrera=d.carrera}}
  </div>

  <p class="max-w-[70ch] text-sm text-tinta-3">Cómo se calcula: el dominio de cada competencia es la probabilidad estimada de que la sepas (modelo BKT) y se aprueba con 91, la calificación mínima de los cursos de Volvo. Los parámetros son de demostración y se calibran con un piloto.</p>
</section>
