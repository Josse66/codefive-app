<section class="grid gap-8">
  <div class="grid max-w-3xl gap-3">
    <h1 class="text-5xl leading-none">Técnicos del Mañana</h1>
    <p class="text-lg text-tinta-2">Diagnostica lo que cada técnico domina por grupo de función del autobús, lo entrena solo en lo que le falta y muestra cuándo está listo para el autobús real.</p>
  </div>

  <div class="grid gap-3">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-3xl">Técnicos</h2>
      <p class="text-sm text-tinta-3">Datos ficticios de demostración</p>
    </div>
    <div class="overflow-x-auto border border-placa-linea bg-white">
      <table class="tabla-partes min-w-[860px]">
        <thead>
          <tr>
            <th>Clave</th>
            <th>Técnico</th>
            <th>Taller</th>
            <th>Experiencia</th>
            <th>Tecnología</th>
            <th>Avance</th>
            <th><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          {{#each tecnicos}}
            <tr>
              <td class="codigo">{{id}}</td>
              <td class="font-semibold">{{nombre}}</td>
              <td>{{taller}}</td>
              <td>{{anios_experiencia}} años</td>
              <td>{{nombreTecnologia tecnologia}}</td>
              <td>
                {{#if diagnosticado}}
                  {{dominadas}} de {{total}} competencias dominadas
                {{else}}
                  <span class="chip border-nada bg-nada-suave text-tinta-3">Sin diagnóstico</span>
                {{/if}}
              </td>
              <td class="text-right">
                <div class="flex justify-end gap-2">
                  {{#if diagnosticado}}
                    <a href="/tecnicos/{{id}}/perfil" class="boton px-4 py-2">Ver competencias</a>
                    <a href="/tecnicos/{{id}}/diagnostico" class="boton-linea px-4 py-2">Repetir diagnóstico</a>
                  {{else}}
                    <a href="/tecnicos/{{id}}/diagnostico" class="boton px-4 py-2">Hacer diagnóstico</a>
                  {{/if}}
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</section>
