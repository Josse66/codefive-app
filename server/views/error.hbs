<section class="grid max-w-3xl gap-4 border border-mal bg-white p-6 lg:p-8">
  <h1 class="text-4xl">Algo salió mal</h1>
  <p>{{mensaje}} Vuelve a intentarlo; si se repite, revisa los logs del servidor.</p>
  {{#if detalle}}
    <pre class="overflow-x-auto bg-tinta p-4 text-xs text-placa">{{detalle}}</pre>
  {{/if}}
  <a href="/" class="boton w-fit">Ir a técnicos</a>
</section>
