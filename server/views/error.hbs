<section class="tarjeta max-w-3xl">
  <p class="etiqueta">Error</p>
  <h1 class="mt-2 text-4xl">Algo salió mal</h1>
  <p class="mt-3">{{mensaje}}</p>
  {{#if detalle}}
    <pre class="mt-4 overflow-x-auto rounded bg-acero-900 p-4 font-mono text-xs text-acero-50">{{detalle}}</pre>
  {{/if}}
  <a href="/" class="boton mt-5">Volver al inicio</a>
</section>
