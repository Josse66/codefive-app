<section id="escenario" class="relative grid gap-5" data-tecnico-id="{{tecnico.id}}" data-escenario-id="{{escenarioId}}" data-orden-id="{{ordenId}}">
  {{> mision-pasos mision=mision clave="hazlo"}}
  {{! Orden de trabajo del Taller: folio, cliente, reloj y gasto en refacciones. }}
  <div id="orden-barra" class="flex flex-wrap items-center gap-x-6 gap-y-2 border-2 border-tinta bg-tinta px-4 py-3 text-white" hidden>
    <span class="codigo text-2xl" id="orden-folio"></span>
    <span id="orden-cliente" class="text-sm text-placa-linea"></span>
    <span class="ml-auto flex items-center gap-6 text-sm">
      <span>Tiempo <span id="orden-reloj" class="codigo text-xl text-white">0:00</span></span>
      <span>Refacciones <span id="orden-gasto" class="codigo text-xl text-white">$0</span></span>
      <a href="/tecnicos/{{tecnico.id}}/taller" class="text-white underline decoration-placa-linea">Salir al taller</a>
    </span>
  </div>

  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="grid gap-2">
      <p class="font-narrow text-sm font-bold uppercase tracking-wider text-tinta-3">Práctica en el autobús · <span id="profundidad"></span></p>
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <span id="grupo" class="recuadro h-9 w-9 text-xl"></span>
        <h1 id="titulo" class="font-sans text-3xl font-semibold leading-tight tracking-normal">Cargando…</h1>
      </div>
      <p id="sintoma" class="max-w-3xl text-[17px] text-tinta-2"></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span id="marca-hv" class="marca-hv" hidden>Alto voltaje 600 V</span>
      <span class="chip border-tinta-3 text-tinta-2">Datos de demostración</span>
      <button id="boton-inmersivo" type="button" class="boton">Entrar al taller (pantalla completa)</button>
    </div>
  </div>

  <div id="area-trabajo" class="grid gap-5 lg:grid-cols-[400px_minmax(0,1fr)] lg:items-start">
    <div id="panel-escenario" class="grid gap-4">
      <ol id="pasos" class="flex flex-wrap gap-1.5" aria-label="Pasos del escenario"></ol>

      <article id="paso" class="grid gap-4 border-2 border-tinta bg-white p-5" hidden aria-live="polite">
        <p id="paso-numero" class="text-sm font-semibold text-tinta-2"></p>
        <h2 id="paso-texto" class="font-sans text-xl font-semibold leading-snug tracking-normal"></h2>
        <div id="opciones" class="grid gap-2" role="radiogroup" aria-labelledby="paso-texto"></div>
        <div id="herramientas" class="grid gap-2" hidden>
          <p class="text-sm text-tinta-3">Elige una herramienta y úsala sobre la pieza en el autobús: clic, pinza con la cámara o botón del guante.</p>
          <div id="bandeja" class="grid grid-cols-2 gap-2"></div>
        </div>
        <p id="subpaso" class="text-sm font-semibold text-tinta-2" hidden></p>
        <div id="pista" class="border border-med bg-med-suave p-3 text-[15px]" hidden></div>
        <div id="retro" class="grid gap-1 border p-3 text-[15px]" hidden></div>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <button id="boton-pista" type="button" class="boton-linea px-4 py-2" hidden>Ver pista</button>
          <button id="boton-continuar" type="button" class="boton ml-auto" hidden>Continuar</button>
        </div>
      </article>

      <article id="final" class="grid gap-3 border-2 border-ok bg-white p-5" hidden>
        <h2 class="text-2xl text-ok">Escenario completo</h2>
        <p id="final-texto"></p>
        <div class="flex flex-wrap gap-2">
          <a id="enlace-evaluacion" href="{{#if siguienteMision}}{{siguienteMision.enlace}}{{else}}#{{/if}}" class="boton" {{#if siguienteMision}}data-mision="1"{{/if}}>{{#if siguienteMision}}Siguiente: {{siguienteMision.nombre}} →{{else}}Comprueba lo aprendido{{/if}}</a>
          <a href="/tecnicos/{{tecnico.id}}/plan" class="boton-linea">Volver a Mi plan</a>
          <button id="boton-repetir" type="button" class="boton-linea">Repetir</button>
        </div>
      </article>

      <div class="grid gap-2 border border-placa-linea bg-white p-4">
        <div class="flex items-baseline justify-between text-sm">
          <span class="font-semibold">Dominio <span id="dominio-codigo" class="codigo"></span></span>
          <span id="dominio-texto" class="codigo">—</span>
        </div>
        <div class="relative h-2 bg-placa-2" aria-hidden="true">
          <div id="dominio-barra" class="h-2 bg-tinta transition-[width] duration-700 ease-out" style="width: 0%"></div>
          <span class="absolute inset-y-[-4px] left-[40%] w-px bg-tinta-3"></span>
          <span class="absolute inset-y-[-4px] left-[80%] w-px bg-tinta-3"></span>
        </div>
        <p id="fuente" class="text-xs text-tinta-3"></p>
      </div>

      <details class="border border-placa-linea bg-white p-4">
        <summary class="cursor-pointer font-semibold">Entradas: mouse, cámara y guante</summary>
        <div class="mt-3 grid gap-3">
          <div class="flex flex-wrap gap-1.5">
            <span data-fuente="mouse" class="chip border-ok bg-ok-suave text-ok">Mouse</span>
            <span data-fuente="camara" class="chip border-nada bg-nada-suave text-tinta-3">Cámara</span>
            <span data-fuente="guante" class="chip border-nada bg-nada-suave text-tinta-3">Guante</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <button id="boton-guante" type="button" class="boton-linea px-3 py-2 text-sm">Conectar guante</button>
            <button id="boton-camara" type="button" class="boton-linea px-3 py-2 text-sm">Iniciar cámara</button>
          </div>
          <video id="video" class="w-full -scale-x-100 bg-tinta" playsinline muted hidden></video>
          <p id="entradas-mensaje" class="text-xs text-tinta-3">Si la cámara o el guante se desconectan, el mouse sigue funcionando.</p>
        </div>
      </details>
      <p id="mensaje-error" class="aviso-critico" hidden></p>
    </div>

    <div id="visor" class="relative h-[460px] border border-tinta bg-placa lg:sticky lg:top-6 lg:h-[680px]">
      <div id="lienzo" class="absolute inset-0"></div>
      {{! Modo inmersivo: mira al centro, ayuda de controles y salida. }}
      <div id="mira" class="pointer-events-none absolute left-1/2 top-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2" hidden aria-hidden="true">
        <span class="absolute left-1/2 top-0 h-full w-0.5 -translate-x-1/2 bg-white mix-blend-difference"></span>
        <span class="absolute left-0 top-1/2 h-0.5 w-full -translate-y-1/2 bg-white mix-blend-difference"></span>
      </div>
      <p id="mira-pieza" class="pointer-events-none absolute left-1/2 top-[calc(50%+22px)] -translate-x-1/2 border border-tinta bg-white px-2 py-1 text-sm font-semibold" hidden></p>
      <div id="ayuda-inmersivo" class="absolute bottom-3 left-1/2 grid -translate-x-1/2 gap-1 border border-tinta bg-white/95 px-4 py-2 text-center text-sm" hidden>
        <p id="ayuda-estado" class="font-semibold">Haz clic en el autobús para tomar el control</p>
        <p class="text-tinta-2">Mouse: mirar · W A S D: caminar · Shift: agacharte · 1–9: herramienta · Clic: usar · Esc: soltar el mouse</p>
      </div>
      <button id="salir-inmersivo" type="button" class="boton-linea absolute right-3 top-14 bg-white px-3 py-2 text-sm" hidden>Salir de pantalla completa</button>
      <p id="etiqueta-pieza" class="pointer-events-none absolute left-3 top-3 border border-tinta bg-white px-2 py-1 text-sm font-semibold" hidden></p>
      <p id="ayuda-orbita" class="pointer-events-none absolute bottom-3 left-3 bg-white/90 px-2 py-1 text-xs text-tinta-3">Clic derecho y arrastrar: girar · rueda: acercar</p>
    </div>
  </div>

  {{! Entrega de la unidad: calificación de la orden. }}
  <div id="entrega" class="fixed inset-0 z-40 grid place-items-center bg-tinta/80 p-6" role="dialog" aria-modal="true" aria-labelledby="entrega-titulo" hidden>
    <div class="grid w-full max-w-lg gap-4 border-2 border-tinta bg-white p-8">
      <p class="font-narrow text-sm font-bold uppercase tracking-wider text-tinta-3">Unidad entregada</p>
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="entrega-titulo" class="text-5xl text-med"><span id="entrega-estrellas"></span></h2>
        <span id="entrega-xp" class="codigo text-4xl"></span>
      </div>
      <ul id="entrega-desglose" class="grid text-[15px]"></ul>
      <p id="entrega-datos" class="text-sm text-tinta-3"></p>
      <div class="grid gap-1">
        <p id="entrega-nivel" class="font-semibold"></p>
        <div class="h-3 bg-placa-2"><div id="entrega-barra" class="h-3 bg-tinta transition-[width] duration-1000 ease-out" style="width: 0%"></div></div>
      </div>
      <div class="flex flex-wrap gap-2">
        <a id="entrega-volver" href="/tecnicos/{{tecnico.id}}/taller" class="boton">Volver al taller</a>
        <a id="entrega-evaluacion" href="#" class="boton-linea">Evaluación de después</a>
      </div>
    </div>
  </div>

  {{! Error crítico: la acción se bloquea y se avisa al responsable, como en el taller. }}
  <div id="bloqueo" class="fixed inset-0 z-40 grid place-items-center bg-mal/90 p-6" role="alertdialog" aria-modal="true" aria-labelledby="bloqueo-titulo" hidden>
    <div class="grid max-w-xl gap-4 border-2 border-white bg-mal p-8 text-white">
      <p class="font-narrow text-sm font-bold uppercase tracking-wider">Acción bloqueada · error crítico de seguridad</p>
      <h2 id="bloqueo-titulo" class="codigo text-6xl"></h2>
      <p id="bloqueo-mensaje" class="text-xl leading-snug"></p>
      <p class="text-[15px] text-white/90">Se registró en la bitácora y se avisó al responsable en el tablero de Volvo.</p>
      <button id="boton-bloqueo" type="button" class="w-fit border-2 border-white bg-white px-6 py-3 font-semibold text-mal hover:bg-mal-suave">Entendido, repetir el paso</button>
    </div>
  </div>
</section>
