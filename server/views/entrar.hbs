{{!-- Entrar con gafete (QR) + PIN, como en planta y en los hospitales: equipos compartidos, muchos
     trabajadores y nada de contraseñas largas. Correo y contraseña quedan para Volvo y responsables. --}}
<div class="mx-auto grid w-full max-w-7xl items-stretch gap-6 lg:grid-cols-[1.05fr_1fr]">
  {{! Vitrina: el autobús real que se va a aprender, girando como en una sala de exhibición. }}
  <aside class="relative hidden min-h-[560px] overflow-hidden border-2 border-tinta bg-tinta text-white lg:block" aria-label="Volvo Access, el autobús de la capacitación">
    <div class="vitrina-fondo absolute inset-0" aria-hidden="true"></div>
    <div id="vitrina" class="absolute inset-x-0 bottom-0 top-[22%]"></div>
    <div class="relative grid gap-2 p-8">
      <p class="font-narrow text-sm font-bold uppercase tracking-[0.18em] text-white/60">Capacitación técnica · Volvo Buses México</p>
      <p class="font-narrow text-5xl font-bold leading-none">Técnicos del Mañana</p>
      <p class="max-w-md text-lg text-white/75">Aprende en un Volvo Access completo: por fuera, por dentro y el motor.</p>
    </div>
    <ol class="absolute inset-x-0 bottom-0 grid grid-cols-3 border-t border-white/15 bg-tinta/70 backdrop-blur">
      <li class="paso-entrada border-r border-white/15 p-4"><span>1</span>Acerca tu gafete</li>
      <li class="paso-entrada border-r border-white/15 p-4"><span>2</span>Escribe tu PIN</li>
      <li class="paso-entrada p-4"><span>3</span>Sigue tu camino</li>
    </ol>
  </aside>
<section id="entrar" class="grid w-full content-start gap-6">

  {{! Paso 1: acercar el gafete a la cámara. }}
  <div id="paso-gafete" class="grid gap-5 border-2 border-tinta bg-white p-6 lg:p-8">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="grid gap-1">
        <p class="font-narrow text-sm font-bold uppercase tracking-wider text-tinta-3">Capacitación de técnicos</p>
        <h1 class="font-sans text-4xl font-semibold leading-tight tracking-normal">Acerca tu gafete a la cámara</h1>
        <p class="text-lg text-tinta-2">Pon el código de tu gafete dentro del cuadro, como en el reloj checador.</p>
      </div>
      <button id="escuchar-gafete" type="button" class="boton-linea px-4 py-3 text-base">🔊 Escuchar</button>
    </div>
    <div class="relative mx-auto aspect-[4/3] w-full max-w-md overflow-hidden border-2 border-tinta bg-tinta">
      <video id="camara" class="h-full w-full -scale-x-100 object-cover" playsinline muted></video>
      <div class="visor-gafete pointer-events-none absolute inset-[16%]" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></div>
      <p id="camara-estado" class="absolute inset-x-0 bottom-0 bg-tinta/80 px-3 py-2 text-center text-white">Encendiendo la cámara…</p>
    </div>
    <details class="text-[15px]">
      <summary class="cursor-pointer font-semibold">¿No funciona la cámara? Escribe el código de tu gafete</summary>
      <form id="form-codigo" class="mt-3 flex flex-wrap gap-2">
        <input id="codigo" name="codigo" autocomplete="off" placeholder="CF-XXXXXX" class="min-w-0 flex-1 border border-tinta-3 px-3 py-3 font-mono text-lg uppercase tracking-widest">
        <button type="submit" class="boton px-6">Continuar</button>
      </form>
    </details>
    <p id="error-gafete" class="aviso-critico" role="alert" hidden></p>
  </div>

  {{! Paso 2: el PIN. Se ve distinto según la experiencia del técnico (Libre o Paso a paso). }}
  <div id="paso-pin" class="grid gap-5 border-2 border-tinta bg-white p-6 lg:p-8" hidden>
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="grid gap-1">
        <h2 id="saludo" class="font-sans text-4xl font-semibold leading-tight tracking-normal"></h2>
        <p id="taller" class="text-tinta-2"></p>
      </div>
      <button id="escuchar-pin" type="button" class="boton-linea px-4 py-3 text-base">🔊 Escuchar</button>
    </div>
    <p id="instruccion-pin" class="text-xl">Escribe tus 4 números.</p>
    <div id="puntos" class="flex justify-center gap-4" aria-live="polite"></div>
    <div id="teclado" class="mx-auto grid w-full max-w-sm grid-cols-3 gap-3"></div>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <button id="ver-numeros" type="button" class="boton-linea px-4 py-2">👁 Ver mis números</button>
      <button id="no-soy-yo" type="button" class="px-4 py-2 text-tinta-2 underline">No soy yo</button>
      <button id="olvide" type="button" class="px-4 py-2 text-tinta-2 underline">Olvidé mi PIN</button>
    </div>
    <div id="mensaje-pin" class="grid gap-1 border p-3 text-lg" role="alert" hidden></div>
  </div>

  {{! Volvo y responsables del taller entran con correo. }}
  <details id="con-correo" class="border border-placa-linea bg-white p-4" {{#if error}}open{{/if}}>
    <summary class="cursor-pointer font-semibold">Entrar con correo (Volvo y responsables de taller)</summary>
    <form method="post" action="/entrar" class="mt-4 grid gap-4">
      {{#if error}}<p class="aviso-critico" role="alert">{{error}}</p>{{/if}}
      <label class="grid gap-1.5">
        <span class="font-semibold">Correo</span>
        <input name="correo" type="email" autocomplete="username" required value="{{correo}}" class="border border-tinta-3 px-3 py-3 text-base focus:border-tinta">
      </label>
      <label class="grid gap-1.5">
        <span class="font-semibold">Contraseña</span>
        <input name="contrasena" type="password" autocomplete="current-password" required class="border border-tinta-3 px-3 py-3 text-base focus:border-tinta">
      </label>
      <button type="submit" class="boton py-3 text-base">Entrar</button>
    </form>
  </details>
</section>
</div>
