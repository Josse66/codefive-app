<section id="taller" class="grid gap-6" data-tecnico-id="{{tecnico.id}}">
  <div class="grid gap-4 border-2 border-tinta bg-white p-5 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:p-6">
    <div class="grid gap-2">
      <p class="font-narrow text-sm font-bold uppercase tracking-wider text-tinta-3">Taller de {{tecnico.nombre}} · {{tecnico.taller}}</p>
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <h1 id="nivel-nombre" class="text-5xl leading-none">—</h1>
        <span id="nivel-xp" class="codigo text-xl text-tinta-2"></span>
      </div>
      <div class="grid max-w-xl gap-1">
        <div class="h-3 bg-placa-2" aria-hidden="true"><div id="nivel-barra" class="h-3 bg-tinta transition-[width] duration-700 ease-out" style="width: 0%"></div></div>
        <p id="nivel-siguiente" class="text-sm text-tinta-3"></p>
      </div>
    </div>
    <dl class="grid grid-cols-2 gap-x-8 gap-y-1 text-sm">
      <div><dt class="text-tinta-3">Reputación</dt><dd id="reputacion" class="codigo text-3xl">—</dd></div>
      <div><dt class="text-tinta-3">Órdenes entregadas</dt><dd id="entregadas" class="codigo text-3xl">0</dd></div>
    </dl>
  </div>

  <div class="grid gap-3">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-3xl">Bahía de trabajo</h2>
      <p class="text-sm text-tinta-3">Órdenes de clientes para poner en práctica lo que aprendes en Mi plan: primero seguridad, luego tus brechas y después repasos.</p>
    </div>
    <ol id="bahia" class="grid gap-4 lg:grid-cols-3"></ol>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start">
    <div class="grid gap-3">
      <h2 class="text-2xl">Órdenes entregadas</h2>
      <div class="overflow-x-auto border border-placa-linea bg-white">
        <table class="tabla-partes min-w-[640px]">
          <thead><tr><th>Folio</th><th>Trabajo</th><th>Calificación</th><th>Experiencia</th><th>Tiempo</th></tr></thead>
          <tbody id="historial"></tbody>
        </table>
      </div>
    </div>
    <aside class="grid gap-3">
      <h2 class="text-2xl">Próximas órdenes</h2>
      <ul id="bloqueados" class="grid border border-placa-linea bg-white"></ul>
    </aside>
  </div>
  <p id="mensaje-error" class="aviso-critico" hidden></p>
</section>
