<header class="bg-tinta text-white">
  <div class="contenedor flex min-h-14 flex-wrap items-center gap-x-10 gap-y-1">
    <a href="/" class="flex items-center gap-3 py-3 font-narrow text-xl font-bold uppercase tracking-wide no-underline">
      <span class="recuadro h-6 w-6 bg-white text-[13px] text-tinta" aria-hidden="true">T</span>
      Técnicos del Mañana
    </a>
    {{#unless sinMenu}}
      {{#if tecnico}}
        <nav aria-label="Secciones del técnico" class="flex flex-wrap gap-1 text-[15px]">
          <a href="/tecnicos/{{tecnico.id}}/camino" class="px-3 py-4 no-underline {{#if (igual seccion 'camino')}}text-white shadow-[inset_0_-3px_0_#ffffff]{{else}}text-placa-linea hover:text-white{{/if}}" {{#if (igual seccion 'camino')}}aria-current="page"{{/if}}>Mi camino</a>
          <a href="/tecnicos/{{tecnico.id}}/autobus" class="px-3 py-4 text-placa-linea no-underline hover:text-white">Autobús 3D</a>
        </nav>
      {{else if esVolvo}}
        <nav aria-label="Capacitación Volvo" class="flex gap-1 text-[15px]">
          <a href="/volvo" class="px-3 py-4 no-underline {{#if (igual seccion 'tablero')}}text-white shadow-[inset_0_-3px_0_#ffffff]{{else}}text-placa-linea hover:text-white{{/if}}" {{#if (igual seccion 'tablero')}}aria-current="page"{{/if}}>Panel</a>
          <a href="/volvo/gafetes" class="px-3 py-4 no-underline {{#if (igual seccion 'gafetes')}}text-white shadow-[inset_0_-3px_0_#ffffff]{{else}}text-placa-linea hover:text-white{{/if}}" {{#if (igual seccion 'gafetes')}}aria-current="page"{{/if}}>Gafetes</a>
          <a href="/tecnicos" class="px-3 py-4 no-underline {{#if (igual seccion 'red')}}text-white shadow-[inset_0_-3px_0_#ffffff]{{else}}text-placa-linea hover:text-white{{/if}}" {{#if (igual seccion 'red')}}aria-current="page"{{/if}}>Red de técnicos</a>
        </nav>
      {{/if}}
    {{/unless}}
    {{#if cuenta}}
      <div class="ml-auto flex items-center gap-4 py-3 text-sm text-placa-linea">
        {{#if esVolvo}}
          {{#if tecnico}}<span>Viendo a <span class="font-semibold text-white">{{tecnico.nombre}}</span></span><a href="/volvo" class="text-white underline decoration-placa-linea hover:decoration-white">Volver al panel</a>{{/if}}
          <span class="font-semibold text-white">{{cuenta.nombre}}</span>
        {{else}}
          <span><span class="font-semibold text-white">{{cuenta.nombre}}</span>{{#if tecnico}} · {{tecnico.taller}}{{/if}}</span>
        {{/if}}
        <form method="post" action="/salir"><button type="submit" class="text-white underline decoration-placa-linea hover:decoration-white">Salir</button></form>
      </div>
    {{/if}}
  </div>
</header>
