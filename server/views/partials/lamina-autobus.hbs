<svg viewBox="0 0 1000 400" class="block h-auto w-full" role="group" aria-label="Lámina del autobús con los grupos de función" fill="none" stroke="#141c24" stroke-linejoin="round">
  <line x1="24" y1="348" x2="992" y2="348" stroke="#c9d1d8" stroke-width="2"/>
  <!-- Carrocería con arcos de rueda; frente a la derecha -->
  <path d="M64 300 L170 300 A60 60 0 0 1 290 300 L730 300 A60 60 0 0 1 850 300 L966 300 L950 104 Q944 72 912 70 L96 70 Q64 72 64 104 Z" fill="#ffffff" stroke-width="2.5"/>
  <!-- Módulo de techo -->
  <rect x="210" y="46" width="420" height="24" rx="3" fill="#e3e8ec" stroke-width="1.5"/>
  <path d="M280 46 V70 M350 46 V70 M420 46 V70 M490 46 V70 M560 46 V70" stroke-width="1"/>
  <!-- Ventanas -->
  <g fill="#e3e8ec" stroke-width="1.5">
    <rect x="88" y="92" width="88" height="84" rx="4"/><rect x="184" y="92" width="88" height="84" rx="4"/>
    <rect x="280" y="92" width="88" height="84" rx="4"/><rect x="376" y="92" width="86" height="84" rx="4"/>
    <rect x="536" y="92" width="70" height="84" rx="4"/><rect x="614" y="92" width="70" height="84" rx="4"/>
    <rect x="692" y="92" width="70" height="84" rx="4"/><rect x="770" y="92" width="74" height="84" rx="4"/>
    <path d="M920 92 L944 92 L958 212 L928 212 Z"/>
  </g>
  <!-- Puertas -->
  <g stroke-width="1.5">
    <rect x="470" y="92" width="58" height="206" fill="#ffffff"/><path d="M499 92 V298"/>
    <rect x="476" y="100" width="18" height="96" fill="#e3e8ec" stroke-width="1"/><rect x="504" y="100" width="18" height="96" fill="#e3e8ec" stroke-width="1"/>
    <rect x="858" y="92" width="54" height="206" fill="#ffffff"/><path d="M885 92 V298"/>
    <rect x="864" y="100" width="16" height="96" fill="#e3e8ec" stroke-width="1"/><rect x="890" y="100" width="16" height="96" fill="#e3e8ec" stroke-width="1"/>
  </g>
  <!-- Líneas de carrocería, compartimento trasero y faro -->
  <path d="M64 196 H470 M528 196 H858 M912 196 H955" stroke-width="1"/>
  <path d="M64 268 H170 M290 268 H470 M528 268 H730 M912 268 H962" stroke-width="1"/>
  <rect x="76" y="208" width="74" height="54" stroke-width="1.5"/>
  <path d="M84 222 H142 M84 234 H142 M84 246 H142" stroke-width="1"/>
  <rect x="938" y="236" width="20" height="14" rx="2" fill="#e3e8ec" stroke-width="1.5"/>
  <!-- Elementos ocultos: bastidor y tren motriz -->
  <g stroke="#55616c" stroke-width="1.2" stroke-dasharray="6 4">
    <path d="M110 288 H900"/>
    <rect x="262" y="258" width="112" height="24"/>
  </g>
  <!-- Ruedas -->
  <g>
    <circle cx="230" cy="304" r="42" fill="#ffffff" stroke-width="2.5"/><circle cx="230" cy="304" r="24" stroke-width="1.5"/><circle cx="230" cy="304" r="7" fill="#141c24"/>
    <circle cx="790" cy="304" r="42" fill="#ffffff" stroke-width="2.5"/><circle cx="790" cy="304" r="24" stroke-width="1.5"/><circle cx="790" cy="304" r="7" fill="#141c24"/>
  </g>

  <!-- Líneas de referencia y recuadros por grupo de función -->
  {{#each grupos}}
    <line x1="{{ax}}" y1="{{ay}}" x2="{{cx}}" y2="{{cy}}" stroke="#55616c" stroke-width="1"/>
  {{/each}}
  {{#each grupos}}
    <circle cx="{{ax}}" cy="{{ay}}" r="3.5" fill="#141c24" stroke="none"/>
    <g class="recuadro-grupo {{#if competencias.length}}cursor-pointer{{/if}}" data-grupo="{{numero}}"
       {{#if competencias.length}}tabindex="0" role="button" aria-pressed="{{#if seleccionado}}true{{else}}false{{/if}}" aria-controls="grupo-{{numero}}"{{else}}aria-disabled="true"{{/if}}
       aria-label="Grupo {{numero}}, {{nombre}}: {{nombreEstado estado}}">
      <title>Grupo {{numero}} · {{nombre}} · {{nombreEstado estado}}</title>
      <rect class="anillo" x="{{sx}}" y="{{sy}}" width="{{sl}}" height="{{sl}}" rx="2" fill="none" stroke="#b3121f" stroke-width="3" {{#unless seleccionado}}visibility="hidden"{{/unless}}/>
      <rect x="{{x}}" y="{{y}}" width="{{lado}}" height="{{lado}}" rx="2" fill="{{rellenoEstado estado}}" stroke="#141c24" stroke-width="1.5"/>
      <text x="{{cx}}" y="{{cy}}" dy="6.5" text-anchor="middle" fill="#ffffff" stroke="none" font-family="'Archivo Narrow', Archivo, sans-serif" font-weight="700" font-size="18">{{numero}}</text>
    </g>
  {{/each}}
</svg>
